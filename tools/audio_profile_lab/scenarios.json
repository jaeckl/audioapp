{
  "scenarios": {
    "light": {
      "description": "Single track, simple oscillator, sustained MIDI note.",
      "dartDefine": "LAB_SCENARIO=light",
      "mapsToBenchmark": "default"
    },
    "parallel": {
      "description": "Four independent oscillator tracks (no cross-routing).",
      "dartDefine": "LAB_SCENARIO=parallel",
      "mapsToBenchmark": "parallel_branches"
    },
    "serial_chain": {
      "description": "Oscillator through distortion, filter, and reverb on one track.",
      "dartDefine": "LAB_SCENARIO=serial_chain",
      "mapsToBenchmark": "serial_chain"
    },
    "subtractive": {
      "description": "Subtractive synth with a short chord pattern.",
      "dartDefine": "LAB_SCENARIO=subtractive",
      "mapsToBenchmark": "subtractive_synth"
    },
    "wavetable": {
      "description": "Wavetable synth with a short chord pattern.",
      "dartDefine": "LAB_SCENARIO=wavetable",
      "mapsToBenchmark": "wavetable_synth"
    },
    "phasemod": {
      "description": "Phase-mod synth with a short chord pattern.",
      "dartDefine": "LAB_SCENARIO=phasemod",
      "mapsToBenchmark": "phasemod_synth"
    },
    "granular": {
      "description": "Granular formant synth with a short chord pattern.",
      "dartDefine": "LAB_SCENARIO=granular",
      "mapsToBenchmark": "granular_synth"
    }
  },
  "profiles": ["low_latency", "balanced", "safe"],
  "defaults": {
    "playSeconds": 20,
    "settleSeconds": 2,
    "sampleIntervalMs": 500,
    "deviceSerial": "ZY32MCWDJ6"
  }
}
